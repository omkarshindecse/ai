import heapq

goal = (1, 2, 3, 4, 5, 6, 7, 8, 0)

def heuristic(state):
    count = 0
    for i in range(9):
        if state[i] != 0:
            count += abs(i // 3 - (state[i]-1) // 3)
            count += abs(i % 3 - (state[i]-1) % 3)
    return count

def solve(start):
    pq = [(heuristic(start), start)]
    visited = set()

    while pq:
        h, state = heapq.heappop(pq)

        if state == goal:
            print("Goal State Reached!")
            for i in range(0, 9, 3):
                print(state[i:i+3])
            return

        if state in visited:
            continue

        visited.add(state)
        zero = state.index(0)

        for move in [-3, 3, -1, 1]:
            new = zero + move

            if 0 <= new < 9:
                if move == -1 and zero % 3 == 0:
                    continue
                if move == 1 and zero % 3 == 2:
                    continue

                temp = list(state)
                temp[zero], temp[new] = temp[new], temp[zero]

                heapq.heappush(pq, (heuristic(tuple(temp)), tuple(temp)))

    print("No solution!")

# Main program
start = (1, 2, 3, 4, 0, 6, 7, 5, 8)

print("Initial State:")
for i in range(0, 9, 3):
    print(start[i:i+3])

solve(start)
