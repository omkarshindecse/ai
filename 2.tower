def solve(n, source, auxiliary, destination):

    if n == 1:
        print("Move disk 1 from", source, "to", destination)
        return

    # Move n-1 disks to auxiliary rod
    solve(n - 1, source, destination, auxiliary)

    # Move largest disk to destination rod
    print("Move disk", n, "from", source, "to", destination)

    # Move n-1 disks to destination rod
    solve(n - 1, auxiliary, source, destination)

# Main program
n = 3

print("Tower of Hanoi with", n, "disks:")

solve(n, 'A', 'B', 'C')

print("All disks moved successfully!")
