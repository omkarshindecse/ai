
# Minimax Algorithm

def minimax(depth, node, isMax, values):

    if depth == 3:
        return values[node]

    if isMax:
        best = -9999

        for i in range(2):
            value = minimax(depth+1, node*2+i, False, values)
            best = max(best, value)

        return best

    else:
        best = 9999

        for i in range(2):
            value = minimax(depth+1, node*2+i, True, values)
            best = min(best, value)

        return best


# Main Program
values = list(map(int, input("Enter 8 values: ").split()))

result = minimax(0, 0, True, values)

print("Best value for MAX player:", result)
